{
	"schemaVersion": 1,
	"id": "btb_skinstudio",
	"version": "${version}",
	"name": "BTB Skin Studio",
	"description": "Cosmetics, Garderobe und Cosmetic-Editor der BTB-Studios-Mod-Familie.",
	"authors": ["Nik2810"],
	"contributors": ["Behind The Blocks contributors"],
	"contact": {
		"sources": "https://github.com/nik0bellic/BTB-Skin-Studio"
	},
	"license": "LGPL-3.0-only",
	"icon": "assets/btb_skinstudio/icon.png",
	"environment": "*",
